        {
          "name": "Generate Access Token (Login)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"john.doe\",\n  \"password\": \"P@ssw0rd123\"\n}"
            },
            "url": "{{baseUrl}}/auth/generate-token",
            "description": "Generates JWT access token and refresh token cookie."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 2xx', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]);",
                  "});",
                  "",
                  "const authHeader = pm.response.headers.get('Authorization');",
                  "pm.test('Authorization header contains bearer token', function () {",
                  "  pm.expect(authHeader).to.exist;",
                  "  pm.expect(authHeader).to.include('Bearer ');",
                  "});",
                  "",
                  "if (authHeader && authHeader.startsWith('Bearer ')) {",
                  "  const token = authHeader.replace('Bearer ', '').trim();",
                  "  pm.collectionVariables.set('accessToken', token);",
                  "",
                  "  const parseJwt = function (jwt) {",
                  "    try {",
                  "      const base64Url = jwt.split('.')[1];",
                  "      const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');",
                  "      const jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {",
                  "        return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);",
                  "      }).join(''));",
                  "      return JSON.parse(jsonPayload);",
                  "    } catch (e) {",
                  "      return null;",
                  "    }",
                  "  };",
                  "",
                  "  const payload = parseJwt(token);",
                  "  if (payload && payload.userId) {",
                  "    pm.collectionVariables.set('userId', String(payload.userId));",
                  "  }",
                  "}",
                  "",
                  "const setCookie = pm.response.headers.get('Set-Cookie');",
                  "if (setCookie) {",
                  "  const cookiePair = setCookie.split(';')[0];",
                  "  if (cookiePair && cookiePair.startsWith('refreshToken=')) {",
                  "    pm.collectionVariables.set('refreshTokenCookie', cookiePair);",
                  "  }",
                  "}",
                  "",
                  "pm.test('Response time is below 5s', function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Access Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "{{refreshTokenCookie}}"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh-token",
            "description": "Rotates refresh token and returns a new access token in Authorization header."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 2xx', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]);",
                  "});",
                  "",
                  "const authHeader = pm.response.headers.get('Authorization');",
                  "if (authHeader && authHeader.startsWith('Bearer ')) {",
                  "  pm.collectionVariables.set('accessToken', authHeader.replace('Bearer ', '').trim());",
                  "}",
                  "",
                  "const setCookie = pm.response.headers.get('Set-Cookie');",
                  "if (setCookie) {",
                  "  const cookiePair = setCookie.split(';')[0];",
                  "  if (cookiePair && cookiePair.startsWith('refreshToken=')) {",
                  "    pm.collectionVariables.set('refreshTokenCookie', cookiePair);",
                  "  }",
                  "}",
                  "",
                  "pm.test('Response time is below 5s', function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
